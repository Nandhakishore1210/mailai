# Copy to .env and fill in. Never commit the filled-in file.
#
# The backend reads backend/.env, so either copy this there or keep one .env at
# the repo root and start uvicorn from it.

# ── Database ─────────────────────────────────────────────────────────────────
# Local Docker default. Port 5435 avoids clashing with an existing Postgres.
DATABASE_URL=postgresql+psycopg2://postgres:password@127.0.0.1:5435/mailai

# ── Secrets you generate yourself ────────────────────────────────────────────
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# ── Google OAuth (console.cloud.google.com > APIs & Services > Credentials) ───
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# ── Anthropic (console.anthropic.com > API Keys) ─────────────────────────────
ANTHROPIC_API_KEY=

# ── URLs ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Realtime push (optional) ─────────────────────────────────────────────────
# Leave GMAIL_PUBSUB_TOPIC empty to use server-side polling instead.
# Setup steps: backend/app/realtime/gmail_push.py
# GMAIL_PUBSUB_TOPIC=projects/<project-id>/topics/gmail-push
GMAIL_PUBSUB_TOPIC=
# Shared secret in the Pub/Sub push URL; the webhook is public without it.
# python -c "import secrets; print(secrets.token_urlsafe(24))"
GMAIL_PUSH_TOKEN=
